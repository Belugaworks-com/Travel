# Copy to .env.local. Every key is optional: without one, SkyPlan uses its
# built-in sample data and labels it as such in the UI.

# Live Google Flights prices (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=

# Live operating carriers per route (https://aviationstack.com/dashboard).
# Uses the flights endpoint, cached for a day per route (free plan: ~100 calls/month).
AVIATIONSTACK_API_KEY=

# Supabase project, for accounts and saved trips (not wired into the UI yet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 21st.dev MCP server (see .mcp.json)
API_KEY_21ST=
